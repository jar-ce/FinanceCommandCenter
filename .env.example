# ==========================================
# FINANCE COMMAND CENTER — ENVIRONMENT CONFIG
# ==========================================

# System Settings
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_command_center
DATABASE_SSL=false

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Market Data Providers (Adapters & API Keys)
DEFAULT_MARKET_DATA_PROVIDER=mock
YAHOO_FINANCE_API_URL=https://query1.finance.yahoo.com
NSE_API_BASE_URL=https://www.nseindia.com/api

# Logging & Observability
LOG_LEVEL=info
