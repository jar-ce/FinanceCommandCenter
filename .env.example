# ==============================================================================
# FINANCE COMMAND CENTER (APEX OS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env for local development or configure environment
# variables directly in your deployment secret manager / PaaS dashboard.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Server listening port (default: 4000)
PORT=4000

# Server network binding interface (default: 0.0.0.0 for container support)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String URI
# Dev/Test Default: Local PGlite in-memory WASM emulator used automatically if NODE_ENV !== 'production'
# Production Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_command_center

# Maximum connection pool size (default: 10)
DATABASE_POOL_SIZE=10

# Enable SSL/TLS for PostgreSQL connection (default: false in dev, true in prod)
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. Authentication & Security (SEC-01 through SEC-07)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing principal HMAC-SHA256 tokens (min 32 characters in production)
# FATAL: Startup fails in production if set to default development string
JWT_SECRET=dev-jwt-secret-min-16-characters-long

# Access token lifespan (default: 15m)
JWT_EXPIRES_IN=15m

# Refresh token lifespan (default: 7d)
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Redis Cache & Token Revocation Store (ioredis 6.x)
# ------------------------------------------------------------------------------
# Shared out-of-process Redis connection URI
# Production Format: rediss://:<password>@<host>:6379 (TLS enabled)
# FATAL: Startup fails in production if REDIS_URL is omitted or empty
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS Policy - SEC-06)
# ------------------------------------------------------------------------------
# Allowed frontend client origin URL (strict matching, no wildcards in production)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Logging & Observability
# ------------------------------------------------------------------------------
# Log level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
LOG_LEVEL=info
