{
  "name": "finance-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Financial Command Center (APEX OS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npx tsc -b packages/shared-types apps/api apps/web",
    "type-check": "npx tsc -b packages/shared-types && npx tsc --noEmit -p apps/api/tsconfig.json && npx tsc --noEmit -p apps/web/tsconfig.json",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
