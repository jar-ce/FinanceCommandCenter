    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
